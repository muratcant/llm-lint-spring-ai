<idea-plugin>
    <id>dev.llmlint.springai</id>
    <name>LLM Lint for Spring AI</name>
    <vendor>LLM Lint</vendor>

    <description><![CDATA[
    Static analysis for <b>Spring AI 2.x</b> code: catches LLM cost and reliability mistakes
    while you type, before they reach production and your invoice.
    <ul>
      <li><b>Missing output limit</b> &ndash; a <code>ChatClient</code> call without a max-tokens limit
          in <code>.options(...)</code>, <code>ChatClient.Builder.defaultOptions(...)</code>
          or <code>spring.ai.&lt;provider&gt;.chat.options.max-tokens</code>.</li>
      <li><b>Unbounded chat memory</b> &ndash; session memory (<code>SessionMemoryAdvisor</code>,
          <code>SessionAdvisors</code>) without <code>EventFilter.lastN(...)</code> or compaction, and
          <code>MessageWindowChatMemory</code> with a huge <code>maxMessages</code>.</li>
    </ul>
    Works for Java and Kotlin.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <!-- The UAST-based inspections cover Kotlin files through the Kotlin plugin. -->
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.LlmLintBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="UAST"
                         shortName="SpringAiMissingOutputLimit"
                         key="inspection.missing.output.limit.display.name"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="dev.llmlint.springai.inspections.MissingOutputLimitInspection"/>
        <localInspection language="UAST"
                         shortName="SpringAiUnboundedChatMemory"
                         key="inspection.unbounded.memory.display.name"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="dev.llmlint.springai.inspections.UnboundedChatMemoryInspection"/>
    </extensions>

    <!-- Must be in the main descriptor; without it the IDE disables Kotlin support for us in K2 mode. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
